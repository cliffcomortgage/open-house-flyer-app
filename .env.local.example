# Database (Neon, Supabase, or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/flyer_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AWS S3 or Cloudflare R2 (image uploads)
STORAGE_PROVIDER="r2"  # "s3" or "r2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Cloudflare R2 (alternative to S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""  # e.g. https://pub-xxx.r2.dev

# SMTP2GO (compliance review notification emails)
SMTP2GO_API_KEY=""
SMTP2GO_FROM_EMAIL="marketing@cliffcomortgage.com"  # must be a verified sender/domain in SMTP2GO
COMPLIANCE_NOTIFICATION_EMAILS="scollinge@cliffcomortgage.com,compliance@cliffcomortgage.com"  # comma-separated

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_SETUP_KEY="change-this-secret-key"  # Used for first-time admin creation
