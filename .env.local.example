# Database (Neon, Supabase, or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/flyer_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AWS S3 or Cloudflare R2 (image uploads)
STORAGE_PROVIDER="r2"  # "s3" or "r2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Cloudflare R2 (alternative to S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""  # e.g. https://pub-xxx.r2.dev

# MLS - SimplyRETS (test credentials: simplyrets / simplyrets)
SIMPLYRETS_API_KEY=""
SIMPLYRETS_SECRET=""
SIMPLYRETS_BASE_URL="https://api.simplyrets.com"

# Optimal Blue API
OPTIMAL_BLUE_CLIENT_ID=""
OPTIMAL_BLUE_CLIENT_SECRET=""
OPTIMAL_BLUE_BASE_URL="https://api.optimalblue.com"
OPTIMAL_BLUE_BUSINESS_CHANNEL_ID=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_SETUP_KEY="change-this-secret-key"  # Used for first-time admin creation
