generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LO
}

enum FlyerStatus {
  DRAFT
  SAVED
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String?
  role        Role         @default(LO)
  isActive    Boolean      @default(true)
  loanOfficer LoanOfficer?
  accounts    Account[]
  sessions    Session[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Company {
  id             String   @id @default(cuid())
  name           String   @default("Cliffco, Inc.")
  primaryColor   String   @default("#003366")
  secondaryColor String   @default("#C9A84C")
  logoUrl        String?
  website        String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LoanOfficer {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  title         String    @default("Loan Officer")
  nmlsNumber    String
  officePhone   String?
  cellPhone     String?
  email         String
  website       String?
  branchAddress String?
  branchNmls    String?
  disclaimer    String?   @db.Text
  headshotUrl   String?
  realtors      Realtor[]
  flyers        Flyer[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Realtor {
  id              String      @id @default(cuid())
  loanOfficerId   String
  loanOfficer     LoanOfficer @relation(fields: [loanOfficerId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  title           String      @default("Realtor")
  companyName     String
  officePhone     String?
  cellPhone       String?
  email           String?
  website         String?
  officeAddress   String?
  headshotUrl     String?
  companyLogoUrl  String?
  brandPrimary    String?
  brandSecondary  String?
  flyers          Flyer[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Flyer {
  id            String      @id @default(cuid())
  loanOfficerId String
  loanOfficer   LoanOfficer @relation(fields: [loanOfficerId], references: [id], onDelete: Cascade)
  realtorId     String?
  realtor       Realtor?    @relation(fields: [realtorId], references: [id])
  templateId    String
  title         String?
  propertyData  Json?
  loanScenarios Json?
  qrCodeData    String?
  pdfUrl        String?
  shareToken    String?     @unique
  status        FlyerStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
